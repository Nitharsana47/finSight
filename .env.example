# Copy this file to .env and fill in your own values. Never commit .env.

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Finnhub market data (free key: https://finnhub.io/register)
NEXT_PUBLIC_FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# MongoDB Atlas connection string
MONGODB_URI=

# Better Auth: any long random string, and the app's URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# Gmail address and a Gmail app password (https://myaccount.google.com/apppasswords)
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Production only, from Inngest Cloud
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
